{
  "name": "meilisearch-movie-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:movies": "node scripts/build-enriched-movies.mjs",
    "build:catalog": "node scripts/convert-catalog-jsonl.mjs",
    "catalog:jsonl": "node scripts/catalog-to-jsonl.mjs",
    "catalog:sync": "node scripts/catalog-to-jsonl.mjs && node scripts/convert-catalog-jsonl.mjs",
    "nlp:serve": "cd nlp_api && uvicorn server:app --host 127.0.0.1 --port 8765",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "seed:meili": "node --env-file=.env scripts/seed-meilisearch.mjs",
    "seed:opensearch": "node --env-file=.env scripts/seed-opensearch.mjs",
    "reindex": "npm run build:movies && npm run seed -- --force",
    "index": "node --env-file=.env scripts/index.mjs",
    "index:create": "node --env-file=.env scripts/index.mjs create",
    "index:delete": "node --env-file=.env scripts/index.mjs delete",
    "index:status": "node --env-file=.env scripts/index.mjs status",
    "index:test": "node --env-file=.env scripts/index.mjs test",
    "index:reset": "node --env-file=.env scripts/index-delete.mjs --force && node --env-file=.env scripts/index-create.mjs && node --env-file=.env scripts/seed.mjs -- --force",
    "meili:reset": "node --env-file=.env scripts/meili-reset.mjs",
    "meili:reindex": "npm run meili:reset -- --build"
  },
  "dependencies": {
    "@meilisearch/instant-meilisearch": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-instantsearch": "^7.15.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@opensearch-project/opensearch": "^3.5.1",
    "meilisearch": "^0.49.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
