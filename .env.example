# Frontend (Vite — exposed to the browser; use search-only key)
VITE_MEILISEARCH_HOST=https://your-instance.meilisearch.io
VITE_MEILISEARCH_SEARCH_API_KEY=your_search_api_key_here
VITE_MEILISEARCH_INDEX_NAME=movies

# Seed script only (never prefix with VITE_)
MEILISEARCH_HOST=https://your-instance.meilisearch.io
MEILISEARCH_MASTER_API_KEY=your_master_api_key_here
MEILISEARCH_INDEX_NAME=movies

# Optional: path to movies dataset (default: ./movies.json)
# MOVIES_JSON_PATH=./movies.json
