# Active search engine: meilisearch | opensearch (frontend + seed router)
VITE_SEARCH_ENGINE=meilisearch
SEARCH_ENGINE=meilisearch

# Shared index name (optional, default: movies)
VITE_SEARCH_INDEX_NAME=movies
SEARCH_INDEX_NAME=movies

# --- Meilisearch (when VITE_SEARCH_ENGINE=meilisearch) ---
VITE_MEILISEARCH_HOST=https://your-instance.meilisearch.io
VITE_MEILISEARCH_SEARCH_API_KEY=your_search_api_key_here

MEILISEARCH_HOST=https://your-instance.meilisearch.io
MEILISEARCH_MASTER_API_KEY=your_master_api_key_here

# --- OpenSearch (when VITE_SEARCH_ENGINE=opensearch) ---
# Browser URL: use /opensearch in dev (Vite proxy) or public OpenSearch URL with CORS
VITE_OPENSEARCH_URL=/opensearch
VITE_OPENSEARCH_USERNAME=admin
VITE_OPENSEARCH_PASSWORD=admin

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
# OPENSEARCH_INSECURE=true

# Optional: OPENSEARCH_API_KEY=... instead of username/password (server + VITE_OPENSEARCH_API_KEY)

# --- NLP (parallel to search engine) ---
# rules | gliner | hybrid
VITE_NLP_MODE=hybrid
VITE_NLP_API_URL=/nlp
NLP_API_URL=http://127.0.0.1:8765

# --- Dataset profile: movies | catalog ---
VITE_DATA_PROFILE=movies
DATA_PROFILE=movies

# --- Data ---
# MOVIES_JSON_PATH=./movies.json
# CATALOG_JSON_PATH=./marwadihub-data.json
# CATALOG_JSONL_PATH=../real_doc/search-documents.jsonl
# IMDB_BASICS_TSV=title.basics.tsv
# IMDB_RATINGS_TSV=title.ratings.tsv
# IMDB_AKAS_TSV=title.akas.tsv
